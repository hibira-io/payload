{
  "name": "@hibira-io/payload",
  "version": "0.1.1",
  "description": "Live content updates for Payload CMS on Hibira (Pusher-compatible): publish, update and delete events from collections and globals, and a Next.js component that refreshes the page when its content changes.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/payload.git"
  },
  "homepage": "https://github.com/hibira-io/payload#readme",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "realtime",
    "websocket",
    "pusher",
    "hibira",
    "nextjs",
    "live"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=14",
    "payload": "^3.0.0",
    "pusher-js": "^8.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "pusher-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "pusher": "^5.3.4"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "^3.92.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "next": "^16.4.3",
    "payload": "^3.92.1",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
